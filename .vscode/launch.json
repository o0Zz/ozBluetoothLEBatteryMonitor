{
  "version": "0.2.0",
  "configurations": [
    {
      // .NET Framework debugging via vsdbg (C# extension / C# Dev Kit). Uses the
      // "coreclr" engine, which also debugs .NET Framework -- but only 64-bit
      // processes, so the Debug build is forced to x64 in the .csproj.
      "name": "Debug BluetoothLEBatteryMonitor (.NET Framework)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build (Debug)",
      "program": "${workspaceFolder}\\ozBluetoothLEBatteryMonitor\\bin\\Debug\\BluetoothLEBatteryMonitor.exe",
      "args": [],
      "cwd": "${workspaceFolder}\\ozBluetoothLEBatteryMonitor\\bin\\Debug",
      "console": "internalConsole",
      "stopAtEntry": false
    }
  ]
}
