{
  "version": "2.0.0",
  "tasks": [
    {
      // Both projects are SDK-style and Microsoft.NETFramework.ReferenceAssemblies
      // supplies the net48 reference assemblies, so the plain .NET SDK builds this
      // repo -- no Visual Studio, no targeting pack, no nuget.exe, no vswhere.
      "label": "build (Debug)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}\\PeripheralBatteryMonitor.sln",
        "-v:m",
        "-nologo"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build (Release)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}\\PeripheralBatteryMonitor.sln",
        "-c",
        "Release",
        "-v:m",
        "-nologo"
      ],
      "problemMatcher": "$msCompile"
    }
  ]
}
